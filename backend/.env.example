# Copy to backend/.env (Bun loads it automatically) or set in the systemd unit.
# Lines marked [CHANGED] are new or changed on the feat/mobile-app branch.

PORT=4000

# [CHANGED] Set to "production" on the VPS. In production, private/loopback client
# addresses never count as "nearby" (they usually mean an untrusted proxy).
NODE_ENV=production

# [CHANGED] Set to 1 if the backend sits behind nginx/Cloudflare/another proxy,
# so cf-connecting-ip / x-forwarded-for gives the real client address.
# Without it every client looks like the proxy and nobody is marked nearby.
# Leave unset when clients connect to Bun directly (then headers can be forged).
TRUST_PROXY=1

# Cloudflare Realtime TURN key (optional; without it peers use STUN only).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
