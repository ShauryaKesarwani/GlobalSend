<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.NFC" />
    <!-- LAN discovery: Android drops multicast packets unless a MulticastLock is held. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keep transfers running when the app is in the background (TransferService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- "Stay reachable" mode: stay discoverable on the local network while closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional so phones without NFC can still install the app. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <application>
        <service
            android:name="com.globalsend.nfc.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync|connectedDevice" />
        <receiver
            android:name="com.globalsend.nfc.RequestActionReceiver"
            android:exported="false" />
        <!-- Lets other GlobalSend phones read our connection details by tapping. -->
        <service
            android:name="com.globalsend.nfc.TapHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/gs_apdu_service" />
        </service>
    </application>
</manifest>
