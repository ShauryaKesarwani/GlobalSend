# Copy to .env.local for development. Values here are baked into the build
# (NEXT_PUBLIC_*), for both the website and the native app (`bun run build:tauri`).
# Lines marked [CHANGED] are new or changed on the feat/mobile-app branch.

# Signaling + TURN backend. Production: your API origin (https). The native app
# build must also point at the production API, not localhost.
NEXT_PUBLIC_API_URL=https://api.example.com

# [CHANGED] Public website origin, no trailing slash. Used in the native app's
# NFC tag link so browsers (Web NFC) and phones without the app can tap.
# Set it for the native app build; harmless on the website.
NEXT_PUBLIC_SITE_URL=https://example.com

# "production" on the deployed site.
NEXT_PUBLIC_APP_ENV=production

# [CHANGED] Google Analytics is on unless this is "false". build:tauri sets it to
# false automatically (the app must work offline).
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# WebRTC data channels per transfer (1-4, default 3).
# NEXT_PUBLIC_TRANSFER_SHARDS=3

# [CHANGED] Removed: NEXT_PUBLIC_TURN_URLS / _USERNAME / _CREDENTIAL. Nothing reads
# them anymore; TURN credentials come from the backend (/api/ice-servers).
